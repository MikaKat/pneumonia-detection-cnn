# Base URL the UI uses for API calls. Default "/api" (same origin, recommended
# for production behind the nginx reverse proxy). Only change if your API lives
# on a different path or origin.
VITE_API_BASE=/api

# Dev-only: where `npm run dev` proxies /api to. Not used in the built app.
# VITE_DEV_API_TARGET=http://localhost:8000
