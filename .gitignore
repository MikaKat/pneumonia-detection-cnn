venv/
__pycache__/
*.pyc
data/

# --------------------------------------------------------------------------
# Gewichte
# --------------------------------------------------------------------------
# Ein Checkpoint ist ~44 MB, im Ordner liegen zehn. Sie sind reproduzierbar
# (Splits, Seed und Skript stehen im Repo), die Ergebnis-CSVs daneben nicht --
# deshalb bleiben die Zahlen versioniert und die Gewichte draussen.
*.pth
# Ausnahmen: genau die Dateien, die der Docker-Build per COPY braucht. Ohne sie
# scheitert das Deployment mit "not found", weil der Build-Kontext nur enthaelt,
# was auch im Repo liegt.
#   rsna_f4_s0_bal10  der ausgelieferte Klassifikator (1 Logit, MODEL_FAMILY=rsna)
#   rsna_f4_s0        die Basislinie ohne Umgewichtung, weiter mitversioniert
#   unet_best   der Lungenfinder; optional, ohne ihn entfaellt nur seine Karte
#   best_model  die frueher ausgelieferte Kermany-Basislinie
# (Bereits verfolgte Dateien beruehrt .gitignore ohnehin nicht -- die Zeilen
# stehen hier, damit die Absicht sichtbar bleibt.)
!checkpoints/best_model.pth
!checkpoints/rsna_f4_s0.pth
!checkpoints/rsna_f4_s0_bal10.pth
!checkpoints/unet_best.pth

# --------------------------------------------------------------------------
# Zwischenstaende, die sich aus den Gewichten neu rechnen lassen
# --------------------------------------------------------------------------
# Roh-Cache der U-Net-Masken (~190 MB nach dem grossen Lauf) und die
# Grad-CAM-Heatmaps (~29 MB). Die AUSGEWERTETEN Zahlen liegen als CSV daneben
# und bleiben versioniert -- nur die Rohbloecke fliegen raus.
*.npz

# --------------------------------------------------------------------------
# Webapp
# --------------------------------------------------------------------------
webapp/node_modules/
webapp/dist/
webapp/dist_v8check/
webapp/vite.config.js.timestamp-*

# --------------------------------------------------------------------------
# Arbeitsdateien, die nicht in die oeffentliche Fassung gehoeren
# --------------------------------------------------------------------------
BACKEND_GUIDE.md
API_CONTRACT.md
AGENTS.md
READMEforMe.md
_to_delete/
PLAN_naechste_session.md
erklaerungen/
